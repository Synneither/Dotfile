animations {
    // Individual animations.

    workspace-switch {
        spring damping-ratio=1.0 stiffness=1200 epsilon=0.0001
    }

    window-open {
        duration-ms 100
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 100
        curve "ease-out-quad"
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
  }
