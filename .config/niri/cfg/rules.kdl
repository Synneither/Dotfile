// 全局窗口规则：应用到所有窗口（无 match 条件）
// These are the default values:

blur {
    // off
    passes 3
    offset 3
    noise 0.02
    saturation 1.5
}

window-rule{
  geometry-corner-radius 20
  clip-to-geometry true
  opacity 0.90
   background-effect {
     blur true
}
}

window-rule{
  match app-id="com.mitchellh.ghostty"
  draw-border-with-background false
}


