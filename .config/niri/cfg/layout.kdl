layout {
    // 窗口间隙（逻辑像素）
    gaps 2
//    background-color "transparent"
    // 有多个窗口时，未最大化的列不自动居中。
    center-focused-column "never"
    // 只有一个列时自动居中。
    always-center-single-column
   // Mod+R 切换的预设列宽。
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 1.0
        // 也可设置固定的像素宽度（受缩放影响）。
        // fixed 1920
    }

    preset-window-heights {
        proportion 0.5
        proportion 0.6
        proportion 1.0
    }
    // 关闭焦点环
    focus-ring {
    }

    border {
    }

}

// ===== Noctalia v5: 模糊概览壁纸（Option 1）=====
// 将 Noctalia 的壁纸模糊层放入 niri 的 overview backdrop 中，
// 使概览模式下显示模糊着色的壁纸背景。
// 对应 Noctalia 配置 [niri/backdrop] 已启用（settings.json 中 wallpaper.overviewEnabled=true）。
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}
